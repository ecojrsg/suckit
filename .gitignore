# ===========================================================================
# SuckIt — Root GitIgnore
# ===========================================================================

# --- OS / System ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- IDEs / Editors ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.project
.classpath
.settings/
.cache/

# --- Node / Package Managers ---
node_modules/
/node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
.yarn-integrity

# --- Frontend (Next.js / React) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.docusaurus/
frontend/tsconfig.tsbuildinfo

# --- Backend (Python) ---
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.venv/
backend/venv/
backend/ENV/
backend/env/
backend/bin/
backend/ipython_log.py
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/.mypy_cache/
backend/.ruff_cache/
backend/pip-log.txt
backend/pip-delete-this-directory.txt

# --- Environment & Credentials ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local
frontend/.env*.local
backend/.env
backend/.*env
.valet
.env.php

# --- Docker & Volumes ---
docker/volumes/
.docker/
docker-compose.override.yml

# --- Downloads, Media & Temp ---
downloads/
temp_downloads/
*.mp4
*.mp3
*.m4a
*.webm
*.part
*.ytdl
*.aria2
*.tmp
*.temp

# --- AI Assistants & Sandbox ---
.antigravitycli/
.antigravitycli
scratch/
