# ===========================================================================
# SuckIt — Root GitIgnore
# ===========================================================================

# --- OS / IDEs ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Node / Next.js (Frontend) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*

# --- Python (Backend) ---
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.venv/
backend/venv/
backend/ENV/
backend/env/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/.mypy_cache/
backend/.ruff_cache/

# --- Environment Variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env*.local
backend/.env

# --- Local Downloads & Docker ---
docker/volumes/
downloads/
temp_downloads/
*.mp4
*.mp3
*.m4a
*.webm
*.part
*.ytdl

# --- CLI / Sandbox ---
.antigravitycli/
scratch/
